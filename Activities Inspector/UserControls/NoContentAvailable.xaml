<UserControl x:Class="Activities_Inspector.UserControls.NoContentAvailable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Activities_Inspector.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Padding="5"
            Background="#badbe3"
            BorderThickness="1"
            Height="30"
            VerticalAlignment="Top"
            Margin="0,5">
        <TextBlock Text="Nessun contenuto da visualizzare. Ripetere la ricerca se necessario."
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
    </Border>
</UserControl>
