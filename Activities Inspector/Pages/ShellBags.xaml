<Page x:Class="Activities_Inspector.Pages.ShellBags"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:fa="http://schemas.fontawesome.com/icons/"
      xmlns:resx="clr-namespace:Activities_Inspector"
      xmlns:converters="clr-namespace:Activities_Inspector.Converters"
      xmlns:models="clr-namespace:Activities_Inspector.Models"
      xmlns:usercontrols="clr-namespace:Activities_Inspector.UserControls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ShellBags"
      DataContext="{Binding ShellBagsViewModel, Source={StaticResource Locator}}">

    <Page.Resources>
        <converters:DateTimeFormatConverter x:Key="DateTimeFormatConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" 
                                              Visible="Visible"
                                              NotVisible="Collapsed"/>
        <converters:CollectionToVisibilityConverter x:Key="CollectionToVisibilityConverter"
                                            Visible="Visible"
                                            Collapsed="Collapsed"/>
        <converters:CollectionToVisibilityConverter x:Key="CollectionToVisibilityConverterOpposite"
                                            Visible="Collapsed"
                                            Collapsed="Visible"/>
        <converters:BooleanToOpacityConverter x:Key="BooleanToOpacityConverter" />

        <DataTemplate DataType="{x:Type models:ShellBagEntry}">
            <Grid Width="{Binding ActualWidth, ElementName=MainGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="0.75*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding AbsolutePath}"
                           ToolTip="{Binding AbsolutePath}"
                           Style="{StaticResource DataTemplateItemStyle}"/>
                <TextBlock Text="{Binding LastRegistryWriteDate, Converter={StaticResource DateTimeFormatConverter}}"
                           Style="{StaticResource DataTemplateItemStyle}"
                           Margin="13,0,0,0"
                           Grid.Column="1"/>
                <TextBlock Text="{Binding RegistryPath}"
                           ToolTip="{Binding RegistryPath}"
                           Style="{StaticResource DataTemplateItemStyle}"
                           Grid.Column="2"/>
                <fa:ImageAwesome Icon="Solid_InfoCircle" Width="12" Height="12" Foreground="#FF6e6e6e"
                                 VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="3">
                    <fa:ImageAwesome.ToolTip>
                        <StackPanel MaxWidth="400">
                            <TextBlock Text="{Binding AbsolutePath}" TextWrapping="Wrap" FontWeight="Bold"/>
                            <TextBlock Text="{Binding RegistryPath}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </fa:ImageAwesome.ToolTip>
                </fa:ImageAwesome>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="0,5,5,5" x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Command="{Binding ExportCommand}"
                    Content="{x:Static resx:Resources.MainWindows_ExportCommand_Content}"
                    Style="{StaticResource Button_Style}"/>

            <Button Command="{Binding LoadShellBagsEntriesCommand}"
                    Content="{x:Static resx:Resources.MainWindows_LoadCommand_Content}"
                    Style="{StaticResource Button_Style}"/>

            <Button Command="{Binding CancelCommand}"
                    Content="Annulla"
                    Style="{StaticResource Button_Style}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>

        <Grid Width="{Binding ActualWidth, ElementName=MainGrid}"
              Background="Gray"
              HorizontalAlignment="Left"
              Height="30"
              Margin="0,5,0,0"
              x:Name="Header"
              Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="0.75*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="20" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static resx:Resources.MainWindows_ShellBags_AbsolutePath}" 
                       Style="{StaticResource HeaderFieldStyle}"
                       MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"
                       Grid.Column="0"  />
            <TextBlock Text="{x:Static resx:Resources.MainWindows_ShellBags_LastRegistryWriteDate}" 
                       Style="{StaticResource HeaderFieldStyle}"
                       Margin="10,0,0,0"
                       MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"
                       Grid.Column="1"  />
            <TextBlock Text="{x:Static resx:Resources.MainWindows_ShellBags_RegistryPath}" 
                       Style="{StaticResource HeaderFieldStyle}"
                       MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"
                       Grid.Column="2"  />
        </Grid>

        <ListBox ItemsSource="{Binding ShellBagsEntries}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AlternationCount="2"
                 Width="Auto"         
                 ItemContainerStyle="{StaticResource Lststyle}"
                 BorderThickness="0"
                 Visibility="{Binding Infos, Converter={StaticResource CollectionToVisibilityConverter}}"
                 Grid.Row="2"/>
        <usercontrols:NoContentAvailable Visibility="{Binding ShellBagsEntries, Converter={StaticResource CollectionToVisibilityConverterOpposite}}"
                                         Opacity="{Binding IsBusy, Converter={StaticResource BooleanToOpacityConverter}}"
                                         Grid.Row="2"/>

        <fa:ImageAwesome Icon="Solid_Spinner"
                         Spin="True"
                         SpinDuration="4"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="#FF504f4e"
                         Width="30"
                         Margin="0,0,25,5"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                         Grid.Row="2"/>
    </Grid>
</Page>
