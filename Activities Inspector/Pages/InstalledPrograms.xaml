<Page x:Class="Activities_Inspector.Pages.InstalledPrograms"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:fa="http://schemas.fontawesome.com/icons/"
      xmlns:resx="clr-namespace:Activities_Inspector"
      xmlns:converters="clr-namespace:Activities_Inspector.Converters"
      xmlns:models="clr-namespace:Activities_Inspector.Models"
      xmlns:usercontrols="clr-namespace:Activities_Inspector.UserControls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="InstalledPrograms"
      DataContext="{Binding InstalledProgramsViewModel, Source={StaticResource Locator}}">

    <Page.Resources>
        <converters:StringDateTimeConverter x:Key="StringDateTimeConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" 
                                              Visible="Visible"
                                              NotVisible="Collapsed"/>
        <converters:CollectionToVisibilityConverter x:Key="CollectionToVisibilityConverter"
                                            Visible="Visible"
                                            Collapsed="Collapsed"/>
        <converters:CollectionToVisibilityConverter x:Key="CollectionToVisibilityConverterOpposite"
                                            Visible="Collapsed"
                                            Collapsed="Visible"/>
        <converters:BooleanToOpacityConverter x:Key="BooleanToOpacityConverter" />

        <DataTemplate DataType="{x:Type models:InstallEntry}">
            <Grid Width="{Binding ActualWidth, ElementName=MainGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding FileName}"
                           Style="{StaticResource DataTemplateItemStyle}"/>
                <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DataSource}" ToolTip="{Binding DataSource}" Style="{StaticResource DataTemplateItemStyle}"/>
                    <fa:ImageAwesome Icon="Solid_InfoCircle" Width="10" Height="10" Foreground="#FF6e6e6e" Margin="4,0,0,0" VerticalAlignment="Center" ToolTip="{Binding DataSource}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FullPath}" ToolTip="{Binding FullPath}" Style="{StaticResource DataTemplateItemStyle}"/>
                    <fa:ImageAwesome Icon="Solid_InfoCircle" Width="10" Height="10" Foreground="#FF6e6e6e" Margin="4,0,0,0" VerticalAlignment="Center" ToolTip="{Binding FullPath}"/>
                </StackPanel>
                <TextBlock Text="{Binding InstallDate, Converter={StaticResource StringDateTimeConverter}}"
                           Style="{StaticResource DataTemplateItemStyle}"
                           Grid.Column="3"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="0,5,5,5" x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Command="{Binding ExportCommand}"
                    Content="{x:Static resx:Resources.MainWindows_ExportCommand_Content}"
                    Style="{StaticResource Button_Style}"/>

            <Button Command="{Binding LoadInstallEntriesCommand}"
                    Content="{x:Static resx:Resources.MainWindows_LoadCommand_Content}"
                    Style="{StaticResource Button_Style}"/>

            <Button Command="{Binding CancelCommand}"
                    Content="Annulla"
                    Style="{StaticResource Button_Style}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>

        <Grid Width="{Binding ActualWidth, ElementName=MainGrid}"
              Background="Gray"
              HorizontalAlignment="Left"
              Height="30"
              Margin="0,5,0,0"
              x:Name="Header"
              Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static resx:Resources.MainWindows_InstallEntry_FileName}" 
                       Style="{StaticResource HeaderFieldStyle}"
                       MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"
                       Grid.Column="0"  />
            <TextBlock Text="{x:Static resx:Resources.MainWindows_InstallEntry_DataSource}" 
                       Style="{StaticResource HeaderFieldStyle}"
                       MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"
                       Grid.Column="1"  />
            <TextBlock Text="{x:Static resx:Resources.MainWindows_InstallEntry_FullPath}" 
                       Style="{StaticResource HeaderFieldStyle}"
                       MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"
                       Grid.Column="2"  />
            <TextBlock Text="{x:Static resx:Resources.MainWindows_InstallEntry_installDate}" 
                       Style="{StaticResource HeaderFieldStyle}"
                       MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"
                       Grid.Column="3"  />
        </Grid>

        <ListBox ItemsSource="{Binding InstallEntries}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AlternationCount="2"
                 Width="Auto"         
                 ItemContainerStyle="{StaticResource Lststyle}"
                 BorderThickness="0"
                 Visibility="{Binding InstallEntries, Converter={StaticResource CollectionToVisibilityConverter}}"
                 Grid.Row="2"/>
        <usercontrols:NoContentAvailable Visibility="{Binding InstallEntries, Converter={StaticResource CollectionToVisibilityConverterOpposite}}"
                                         Opacity="{Binding IsBusy, Converter={StaticResource BooleanToOpacityConverter}}"
                                         Grid.Row="2"/>

        <fa:ImageAwesome Icon="Solid_Spinner"
                         Spin="True"
                         SpinDuration="4"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="#FF504f4e"
                         Width="30"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                         Grid.Row="2"/>
    </Grid>
</Page>
