<Window x:Class="Activities_Inspector.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:resx="clr-namespace:Activities_Inspector"
        xmlns:converters="clr-namespace:Activities_Inspector.Converters"
        xmlns:models="clr-namespace:Activities_Inspector.Models"
        mc:Ignorable="d"
        Title="{x:Static resx:Resources.AppName}" Height="450" Width="800"
        WindowState="Maximized"
        DataContext="{Binding MainViewModel, Source={StaticResource Locator}}">

    <Window.Resources>
        <converters:ViewerModeNameConverter x:Key="ViewerModeNameConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"
                                              Visible="Visible"
                                              NotVisible="Collapsed"/>

        <DataTemplate DataType="{x:Type models:LeftNavbarItem}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Converter={StaticResource ViewerModeNameConverter}}"
                           Style="{StaticResource WizardItemStyle}"/>
                <Image Source="../Assets/shield.png" 
                       Visibility="{Binding RequiresAdminPrivileges, Converter={StaticResource BoolToVisibilityConverter}}"
                       Width="20" 
                       Height="20"
                       Margin="8,0,5,0" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.18*"
                              MinWidth="270"/>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0"
                        Margin="0,5,5,5">
                <TextBlock Text="{Binding EvidenceSourceDescription}"
                           ToolTip="{Binding EvidenceSourceDescription}"
                           Foreground="White"
                           FontSize="12"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding SelectLiveCommand}"
                            Content="Live"
                            Margin="0,0,5,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button_Style}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLiveMode}" Value="True">
                                        <Setter Property="Background" Value="#FF53b334"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding SelectImageCommand}"
                            Content="Immagine...">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button_Style}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLiveMode}" Value="False">
                                        <Setter Property="Background" Value="#FF53b334"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>
            <ListView ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}"
                      Background="#FF00365C"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      Margin="0,5,5,0"
                      Grid.Row="1">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Height" Value="50" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#FFbfbfbb" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <Button DataContext="{Binding ReportViewModel, Source={StaticResource Locator}}" 
                    Command="{Binding OpenReportWindowCommand}"
                    Content="{x:Static resx:Resources.MainWindow_Report_Button_Content}"
                    Style="{StaticResource Report_Button_Style}" 
                    Height="40"
                    VerticalAlignment="Bottom"
                    Margin="0,5,5,0"
                    Grid.Row="2" />
        </Grid>

        <Frame x:Name="MainFrame"
               NavigationUIVisibility="Hidden"
               RenderTransformOrigin="0.5,0.5"
               Source="/Pages/TimeIntervals.xaml"
               Grid.Column="1" />
    </Grid>
</Window>
